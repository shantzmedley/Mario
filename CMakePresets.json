{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MARIO_ENABLE_NETWORK_PLAY": "ON"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [ "Windows" ],
          "intelliSenseMode": "windows-msvc-x64"
        }
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MARIO_ENABLE_NETWORK_PLAY": "ON"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [ "Windows" ],
          "intelliSenseMode": "windows-msvc-x64"
        }
      }
    },
    {
      "name": "wsl2-debug",
      "displayName": "WSL2 GCC Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "environment": {
        "CC": "gcc",
        "CXX": "g++"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MARIO_ENABLE_NETWORK_PLAY": "ON"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [ "Linux" ],
          "intelliSenseMode": "linux-gcc-x64"
        },
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}",
          "copySources": true,
          "copySourcesOptions": {
            "exclusionList": [
              ".git",
              ".vs",
              ".vscode",
              "build",
              "build-*",
              "out"
            ],
            "method": "rsync"
          },
          "copyBuildOutput": false,
          "forceWSL1Toolset": false
        }
      }
    },
    {
      "name": "wsl2-release",
      "displayName": "WSL2 GCC Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "environment": {
        "CC": "gcc",
        "CXX": "g++"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MARIO_ENABLE_NETWORK_PLAY": "ON"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [ "Linux" ],
          "intelliSenseMode": "linux-gcc-x64"
        },
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}",
          "copySources": true,
          "copySourcesOptions": {
            "exclusionList": [
              ".git",
              ".vs",
              ".vscode",
              "build",
              "build-*",
              "out"
            ],
            "method": "rsync"
          },
          "copyBuildOutput": false,
          "forceWSL1Toolset": false
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release"
    },
    {
      "name": "wsl2-debug",
      "configurePreset": "wsl2-debug"
    },
    {
      "name": "wsl2-release",
      "configurePreset": "wsl2-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "wsl2-debug",
      "configurePreset": "wsl2-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "wsl2-release",
      "configurePreset": "wsl2-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
